{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capy.network/schemas/v1/common.schema.json",
  "title": "capy protocol common definitions",
  "description": "Reusable primitives for capy protocol 1.x objects.",
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "nonNegativeIntegerString": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "role"],
      "properties": {
        "actor_id": {
          "type": "string",
          "format": "uri"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9._-]*$"
        },
        "key_id": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "objectReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "object_type", "object_digest"],
      "properties": {
        "object_id": {
          "type": "string",
          "format": "uri"
        },
        "object_type": {
          "enum": [
            "capability_manifest",
            "episode_cohort",
            "evaluation_receipt",
            "attribution_result",
            "solana_payout_manifest"
          ]
        },
        "object_digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "capabilityReference": {
      "allOf": [
        {"$ref": "#/$defs/objectReference"},
        {"type": "object", "required": ["object_type"], "properties": {"object_type": {"const": "capability_manifest"}}}
      ]
    },
    "cohortReference": {
      "allOf": [
        {"$ref": "#/$defs/objectReference"},
        {"type": "object", "required": ["object_type"], "properties": {"object_type": {"const": "episode_cohort"}}}
      ]
    },
    "evaluationReference": {
      "allOf": [
        {"$ref": "#/$defs/objectReference"},
        {"type": "object", "required": ["object_type"], "properties": {"object_type": {"const": "evaluation_receipt"}}}
      ]
    },
    "attributionReference": {
      "allOf": [
        {"$ref": "#/$defs/objectReference"},
        {"type": "object", "required": ["object_type"], "properties": {"object_type": {"const": "attribution_result"}}}
      ]
    },
    "payoutReference": {
      "allOf": [
        {"$ref": "#/$defs/objectReference"},
        {"type": "object", "required": ["object_type"], "properties": {"object_type": {"const": "solana_payout_manifest"}}}
      ]
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "media_type", "digest"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "size_bytes": {
          "$ref": "#/$defs/nonNegativeIntegerString"
        },
        "encryption": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme", "key_reference"],
          "properties": {
            "scheme": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "key_reference": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "hash_algorithm",
        "digest_scope",
        "object_digest"
      ],
      "properties": {
        "canonicalization": {
          "const": "RFC8785"
        },
        "hash_algorithm": {
          "const": "sha-256"
        },
        "digest_scope": {
          "const": "object-without-integrity-or-signatures"
        },
        "object_digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "signed_digest",
        "signature_base64url",
        "created_at"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "format": "uri"
        },
        "signed_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "signature_base64url": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "qosProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reliability", "durability", "history", "depth"],
      "properties": {
        "reliability": {
          "enum": ["best_effort", "reliable"]
        },
        "durability": {
          "enum": ["volatile", "transient_local"]
        },
        "history": {
          "const": "keep_last"
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "rightsGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grant_id",
        "purposes",
        "commercial_use",
        "derivatives",
        "sublicensing",
        "valid_from",
        "territories"
      ],
      "properties": {
        "grant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "quality_control",
              "training",
              "evaluation",
              "benchmarking",
              "model_distribution",
              "commercialization",
              "audit"
            ]
          }
        },
        "commercial_use": {
          "type": "boolean"
        },
        "derivatives": {
          "type": "boolean"
        },
        "sublicensing": {
          "type": "boolean"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "territories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "restrictions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "rightsBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_id",
        "licensor",
        "grantee",
        "license_document",
        "grants"
      ],
      "properties": {
        "rights_id": {
          "type": "string",
          "format": "uri"
        },
        "licensor": {
          "$ref": "#/$defs/actor"
        },
        "grantee": {
          "$ref": "#/$defs/actor"
        },
        "license_document": {
          "$ref": "#/$defs/artifactReference"
        },
        "grants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rightsGrant"
          }
        }
      }
    },
    "consentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "subject_role",
        "record",
        "granted_at",
        "scopes",
        "withdrawal_endpoint"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/actor"
        },
        "subject_role": {
          "enum": ["operator", "bystander", "property_controller", "data_subject"]
        },
        "record": {
          "$ref": "#/$defs/artifactReference"
        },
        "granted_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "record",
              "store",
              "quality_control",
              "train",
              "evaluate",
              "attribute",
              "pay"
            ]
          }
        },
        "withdrawal_endpoint": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "consentBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_modalities", "records", "no_unconsented_bystanders_attested"],
      "properties": {
        "capture_modalities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["camera", "audio", "biometric", "proprioception", "environment_sensors", "personal_data_categories"],
          "properties": {
            "camera": {"type": "boolean"},
            "audio": {"type": "boolean"},
            "biometric": {"type": "boolean"},
            "proprioception": {"type": "boolean"},
            "environment_sensors": {"type": "boolean"},
            "personal_data_categories": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/consentRecord"
          }
        },
        "no_unconsented_bystanders_attested": {
          "type": "boolean"
        }
      }
    },
    "revocationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "effective_at", "scope", "effect", "evidence"],
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uri"
        },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope": {
          "enum": ["all", "specified_episodes", "specified_purposes"]
        },
        "episode_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "purposes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "effect": {
          "enum": [
            "quarantine",
            "stop_future_use",
            "delete_offchain_artifacts",
            "contract_defined_remediation"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/artifactReference"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"scope": {"const": "specified_episodes"}}},
          "then": {"properties": {"episode_ids": {}}, "required": ["episode_ids"]}
        },
        {
          "if": {"properties": {"scope": {"const": "specified_purposes"}}},
          "then": {"properties": {"purposes": {}}, "required": ["purposes"]}
        }
      ]
    },
    "revocationStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checked_at",
        "registry_uri",
        "registry_snapshot_digest",
        "events"
      ],
      "properties": {
        "status": {
          "enum": ["active", "partially_revoked", "revoked", "disputed"]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "registry_uri": {
          "type": "string",
          "format": "uri"
        },
        "registry_snapshot_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revocationEvent"
          }
        }
      }
    }
  }
}
