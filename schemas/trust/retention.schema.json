{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capy.network/schemas/trust/v1/retention.schema.json",
  "title": "capy retention and disposal record",
  "type": "object",
  "required": ["meta", "retentionId", "recordClass", "purpose", "trigger", "triggerAt", "deleteAt", "maximumDays", "owner", "jurisdictions", "disposal", "backupPropagationDays", "status"],
  "properties": {
    "meta": { "$ref": "common.schema.json#/$defs/recordMeta" },
    "retentionId": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "recordClass": { "enum": ["rejected_raw_capture", "accepted_raw_capture", "redacted_episode", "transient_work_file", "rights_evidence", "facility_evidence", "lineage", "gate_decision", "evaluation_result", "wallet_mapping", "payment_record", "dispute", "incident", "backup"] },
    "purpose": { "type": "string", "minLength": 10, "maxLength": 1000 },
    "trigger": { "enum": ["created", "collection_closed", "derivative_verified", "intended_use_expired", "last_authorized_use", "artifact_retired", "relationship_ended", "case_closed", "incident_closed", "backup_created"] },
    "triggerAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "deleteAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "minimumDays": { "type": "integer", "minimum": 0, "maximum": 36500 },
    "maximumDays": { "type": "integer", "minimum": 1, "maximum": 36500 },
    "legalBasis": { "type": "string", "minLength": 3, "maxLength": 1000 },
    "owner": { "$ref": "common.schema.json#/$defs/actorRef" },
    "jurisdictions": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/jurisdiction" } },
    "disposal": {
      "type": "object",
      "required": ["method", "replicasIncluded", "cachesIncluded", "evidenceRequired"],
      "properties": {
        "method": { "enum": ["logical_delete_then_sanitize", "cryptographic_erase", "physical_destroy", "provider_verified_delete", "tombstone_only_immutable_system"] },
        "replicasIncluded": { "const": true },
        "cachesIncluded": { "const": true },
        "evidenceRequired": { "const": true }
      },
      "additionalProperties": false
    },
    "backupPropagationDays": { "type": "integer", "minimum": 0, "maximum": 365 },
    "legalHolds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["holdRef", "scope", "placedAt", "placedBy", "reviewAt", "status"],
        "properties": {
          "holdRef": { "$ref": "common.schema.json#/$defs/opaqueId" },
          "scope": { "type": "string", "minLength": 3, "maxLength": 1000 },
          "placedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
          "placedBy": { "$ref": "common.schema.json#/$defs/actorRef" },
          "reviewAt": { "$ref": "common.schema.json#/$defs/timestamp" },
          "status": { "enum": ["active", "released", "expired"] },
          "releasedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
        },
        "additionalProperties": false
      }
    },
    "status": { "enum": ["scheduled", "held", "due", "deleting", "deleted", "failed", "extended"] },
    "extension": {
      "type": "object",
      "required": ["newDeleteAt", "necessity", "approvedBy", "approvedAt"],
      "properties": {
        "newDeleteAt": { "$ref": "common.schema.json#/$defs/timestamp" },
        "necessity": { "type": "string", "minLength": 20, "maxLength": 2000 },
        "approvedBy": { "$ref": "common.schema.json#/$defs/actorRef" },
        "approvedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "deletionEvidence": { "$ref": "common.schema.json#/$defs/evidenceRef" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "held" } }, "required": ["status"] }, "then": { "required": ["legalHolds"], "properties": { "legalHolds": { "type": "array", "contains": { "type": "object", "properties": { "status": { "const": "active" } }, "required": ["status"] } } } } },
    { "if": { "properties": { "status": { "const": "extended" } }, "required": ["status"] }, "then": { "required": ["extension"] } },
    {
      "if": { "properties": { "status": { "const": "deleted" } }, "required": ["status"] },
      "then": {
        "required": ["deletionEvidence"],
        "properties": {
          "legalHolds": {
            "type": "array",
            "not": { "contains": { "type": "object", "properties": { "status": { "const": "active" } }, "required": ["status"] } }
          }
        }
      }
    },
    { "if": { "properties": { "recordClass": { "const": "rejected_raw_capture" } }, "required": ["recordClass"] }, "then": { "properties": { "maximumDays": { "type": "integer", "maximum": 30 } } } },
    { "if": { "properties": { "recordClass": { "const": "accepted_raw_capture" } }, "required": ["recordClass"] }, "then": { "properties": { "maximumDays": { "type": "integer", "maximum": 90 } } } },
    { "if": { "properties": { "recordClass": { "const": "redacted_episode" } }, "required": ["recordClass"] }, "then": { "properties": { "maximumDays": { "type": "integer", "maximum": 366 } } } },
    { "if": { "properties": { "recordClass": { "const": "transient_work_file" } }, "required": ["recordClass"] }, "then": { "properties": { "maximumDays": { "type": "integer", "maximum": 7 } } } },
    { "if": { "properties": { "recordClass": { "enum": ["rights_evidence", "facility_evidence", "lineage", "gate_decision", "wallet_mapping", "payment_record", "dispute", "incident"] } }, "required": ["recordClass"] }, "then": { "properties": { "maximumDays": { "type": "integer", "maximum": 2557 } } } },
    { "if": { "properties": { "recordClass": { "const": "evaluation_result" } }, "required": ["recordClass"] }, "then": { "properties": { "maximumDays": { "type": "integer", "maximum": 1096 } } } },
    { "if": { "properties": { "recordClass": { "const": "backup" } }, "required": ["recordClass"] }, "then": { "properties": { "maximumDays": { "type": "integer", "maximum": 35 } } } }
  ],
  "additionalProperties": false
}
