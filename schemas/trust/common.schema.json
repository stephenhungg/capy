{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capy.network/schemas/trust/v1/common.schema.json",
  "title": "capy trust common types",
  "$defs": {
    "opaqueId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{22,86}$",
      "description": "type-prefixed, non-semantic identifier backed by at least 128 random bits"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "enum": ["sha256", "sha384", "sha512", "blake3"] },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64,128}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "algorithm": { "const": "sha256" } }, "required": ["algorithm"] },
          "then": { "properties": { "value": { "type": "string", "minLength": 64, "maxLength": 64 } } }
        },
        {
          "if": { "properties": { "algorithm": { "const": "sha384" } }, "required": ["algorithm"] },
          "then": { "properties": { "value": { "type": "string", "minLength": 96, "maxLength": 96 } } }
        },
        {
          "if": { "properties": { "algorithm": { "enum": ["sha512"] } }, "required": ["algorithm"] },
          "then": { "properties": { "value": { "type": "string", "minLength": 128, "maxLength": 128 } } }
        },
        {
          "if": { "properties": { "algorithm": { "const": "blake3" } }, "required": ["algorithm"] },
          "then": { "properties": { "value": { "type": "string", "minLength": 64, "maxLength": 64 } } }
        }
      ],
      "additionalProperties": false
    },
    "recordMeta": {
      "type": "object",
      "required": ["schemaVersion", "recordedAt"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "recordedAt": { "$ref": "#/$defs/timestamp" },
        "supersedes": {
          "type": "array",
          "items": { "$ref": "#/$defs/opaqueId" },
          "uniqueItems": true,
          "default": []
        }
      },
      "additionalProperties": false
    },
    "actorRef": {
      "type": "object",
      "required": ["actorRef", "role"],
      "properties": {
        "actorRef": { "$ref": "#/$defs/opaqueId" },
        "role": {
          "enum": [
            "contributor", "representative", "facility_authority", "controller",
            "processor", "job_owner", "rights_steward", "privacy_owner",
            "safety_owner", "security_owner", "governance_owner", "legal_counsel",
            "lineage_owner", "evaluator", "evaluation_approver",
            "payout_operator", "incident_commander", "appeal_reviewer", "service"
          ]
        }
      },
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "object",
      "required": ["evidenceRef", "digest", "accessClass"],
      "properties": {
        "evidenceRef": { "$ref": "#/$defs/opaqueId" },
        "digest": { "$ref": "#/$defs/digest" },
        "mediaType": { "type": "string", "minLength": 3, "maxLength": 127 },
        "accessClass": { "enum": ["internal", "restricted", "highly_restricted", "public"] },
        "uri": { "type": "string", "format": "uri", "maxLength": 2048 }
      },
      "additionalProperties": false
    },
    "jurisdiction": {
      "type": "object",
      "required": ["country", "connection", "rulesetVersion", "counselStatus"],
      "properties": {
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "subdivision": { "type": "string", "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$" },
        "connection": {
          "enum": [
            "contributor_location", "subject_residence_claim", "collection_location",
            "facility_location", "controller_establishment", "processor_location",
            "storage_location", "training_location", "evaluation_location",
            "recipient_location", "publication_target", "payout_location"
          ]
        },
        "rulesetVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "counselStatus": { "enum": ["not_reviewed", "required", "approved", "rejected", "expired"] },
        "counselDecisionRef": { "$ref": "#/$defs/opaqueId" }
      },
      "allOf": [
        {
          "if": { "properties": { "counselStatus": { "enum": ["approved", "rejected"] } }, "required": ["counselStatus"] },
          "then": { "required": ["counselDecisionRef"] }
        }
      ],
      "additionalProperties": false
    },
    "restriction": {
      "type": "object",
      "required": ["code", "effect"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$" },
        "effect": { "enum": ["allow", "deny", "require", "limit"] },
        "value": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "array" }
          ]
        },
        "sourceRef": { "$ref": "#/$defs/opaqueId" }
      },
      "additionalProperties": false
    },
    "solanaAddress": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
      "description": "application must additionally base58-decode to exactly 32 bytes"
    },
    "solanaSignature": {
      "type": "string",
      "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,88}$",
      "description": "application must additionally base58-decode to exactly 64 bytes"
    },
    "amountBaseUnits": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    }
  }
}
