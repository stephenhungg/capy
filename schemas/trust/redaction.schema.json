{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capy.network/schemas/trust/v1/redaction.schema.json",
  "title": "capy redaction record",
  "type": "object",
  "required": ["meta", "redactionId", "sourceEntityRef", "state", "reviewPurpose", "detectedCategories", "transforms", "retentionRef"],
  "properties": {
    "meta": { "$ref": "common.schema.json#/$defs/recordMeta" },
    "redactionId": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "sourceEntityRef": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "state": { "enum": ["unreviewed", "in_review", "redacted", "clear", "quarantined", "rejected", "tombstoned"] },
    "reviewPurpose": { "const": "rights_privacy_safety_review" },
    "detectedCategories": { "type": "array", "uniqueItems": true, "items": { "enum": ["face", "voice", "badge", "license_plate", "document_text", "display_content", "precise_location", "contact", "biometric", "health", "minor", "bystander", "confidential_process", "third_party_property", "other_sensitive"] } },
    "transforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["transform", "target", "toolRef", "toolVersion", "performedAt"],
        "properties": {
          "transform": { "enum": ["blur", "mask", "crop", "segment_delete", "voice_remove", "voice_transform", "text_mask", "location_coarsen", "metadata_strip", "field_suppress", "manual_edit"] },
          "target": { "type": "string", "minLength": 1, "maxLength": 512 },
          "toolRef": { "$ref": "common.schema.json#/$defs/opaqueId" },
          "toolVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
          "performedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
        },
        "additionalProperties": false
      }
    },
    "outputEntityRef": { "$ref": "common.schema.json#/$defs/opaqueId" },
    "outputDigest": { "$ref": "common.schema.json#/$defs/digest" },
    "verification": {
      "type": "object",
      "required": ["method", "sampleRate", "acceptanceThreshold", "measuredScore", "passed"],
      "properties": {
        "method": { "enum": ["human_full", "human_sample", "automated_plus_human", "automated"] },
        "sampleRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "acceptanceThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "measuredScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "passed": { "type": "boolean" },
        "verifiedBy": { "$ref": "common.schema.json#/$defs/actorRef" }
      },
      "additionalProperties": false
    },
    "reviewedBy": { "$ref": "common.schema.json#/$defs/actorRef" },
    "reviewedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "reasonCodes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$" }, "uniqueItems": true },
    "deletionEvidence": { "$ref": "common.schema.json#/$defs/evidenceRef" },
    "retentionRef": { "$ref": "common.schema.json#/$defs/opaqueId" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "redacted" } }, "required": ["state"] },
      "then": { "required": ["outputEntityRef", "outputDigest", "verification", "reviewedBy", "reviewedAt"], "properties": { "detectedCategories": { "type": "array", "minItems": 1 }, "transforms": { "type": "array", "minItems": 1 }, "verification": { "type": "object", "properties": { "passed": { "const": true } } } } }
    },
    {
      "if": { "properties": { "state": { "const": "clear" } }, "required": ["state"] },
      "then": { "required": ["verification", "reviewedBy", "reviewedAt"], "properties": { "detectedCategories": { "type": "array", "maxItems": 0 }, "transforms": { "type": "array", "maxItems": 0 }, "verification": { "type": "object", "properties": { "passed": { "const": true } } } } }
    },
    {
      "if": { "properties": { "state": { "const": "unreviewed" } }, "required": ["state"] },
      "then": { "properties": { "detectedCategories": { "type": "array", "maxItems": 0 }, "transforms": { "type": "array", "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "state": { "enum": ["in_review", "quarantined", "rejected", "tombstoned"] } }, "required": ["state"] },
      "then": { "required": ["reviewedBy", "reviewedAt"] }
    },
    {
      "if": { "properties": { "state": { "const": "rejected" } }, "required": ["state"] },
      "then": { "required": ["reasonCodes"], "properties": { "reasonCodes": { "type": "array", "minItems": 1 } } }
    },
    {
      "if": { "properties": { "state": { "const": "tombstoned" } }, "required": ["state"] },
      "then": { "required": ["reasonCodes", "deletionEvidence"], "properties": { "reasonCodes": { "type": "array", "minItems": 1 } } }
    }
  ],
  "additionalProperties": false
}
