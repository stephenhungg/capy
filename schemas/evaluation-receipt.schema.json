{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capy.network/schemas/v1/evaluation-receipt.schema.json",
  "title": "capy evaluation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "protocol_version",
    "schema_version",
    "object_type",
    "object_id",
    "issued_at",
    "payload",
    "integrity",
    "signatures"
  ],
  "properties": {
    "$schema": {"const": "https://capy.network/schemas/v1/evaluation-receipt.schema.json"},
    "protocol_version": {"const": "1.0.0"},
    "schema_version": {"const": "1.0.0"},
    "object_type": {"const": "evaluation_receipt"},
    "object_id": {"type": "string", "format": "uri"},
    "issued_at": {"type": "string", "format": "date-time"},
    "supersedes": {"$ref": "common.schema.json#/$defs/evaluationReference"},
    "payload": {"$ref": "#/$defs/payload"},
    "integrity": {"$ref": "common.schema.json#/$defs/integrity"},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/signature"}
    }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "evaluator",
        "evaluated_at",
        "baseline_policy",
        "candidate_policy",
        "training_cohorts",
        "eligibility_snapshot",
        "hidden_set",
        "execution",
        "metrics",
        "safety",
        "decision"
      ],
      "properties": {
        "capability": {"$ref": "common.schema.json#/$defs/capabilityReference"},
        "evaluator": {"$ref": "common.schema.json#/$defs/actor"},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "baseline_policy": {"$ref": "#/$defs/policy"},
        "candidate_policy": {"$ref": "#/$defs/policy"},
        "training_cohorts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/cohortReference"}
        },
        "eligibility_snapshot": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/eligibilitySnapshot"}
        },
        "hidden_set": {"$ref": "#/$defs/hiddenSetUse"},
        "execution": {"$ref": "#/$defs/execution"},
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/metricResult"}
        },
        "safety": {"$ref": "#/$defs/safetyResult"},
        "decision": {"$ref": "#/$defs/decision"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "artifact", "code_revision", "configuration", "training_run"],
      "properties": {
        "policy_id": {"type": "string", "format": "uri"},
        "artifact": {"$ref": "common.schema.json#/$defs/artifactReference"},
        "code_revision": {"$ref": "common.schema.json#/$defs/sha256Digest"},
        "configuration": {"$ref": "common.schema.json#/$defs/artifactReference"},
        "training_run": {"$ref": "common.schema.json#/$defs/artifactReference"}
      }
    },
    "eligibilitySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohort", "rights_valid", "consent_valid", "revocation_status", "checked_at", "registry_snapshot_digest"],
      "properties": {
        "cohort": {"$ref": "common.schema.json#/$defs/cohortReference"},
        "rights_valid": {"type": "boolean"},
        "consent_valid": {"type": "boolean"},
        "revocation_status": {"enum": ["active", "partially_revoked", "revoked", "disputed"]},
        "checked_at": {"type": "string", "format": "date-time"},
        "registry_snapshot_digest": {"$ref": "common.schema.json#/$defs/sha256Digest"}
      }
    },
    "hiddenSetUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "set_id",
        "manifest_commitment",
        "custodian",
        "candidate_access",
        "training_overlap_detected",
        "access_log",
        "item_level_results",
        "reveal_status"
      ],
      "properties": {
        "set_id": {"type": "string", "format": "uri"},
        "manifest_commitment": {"$ref": "common.schema.json#/$defs/sha256Digest"},
        "custodian": {"$ref": "common.schema.json#/$defs/actor"},
        "candidate_access": {"const": false},
        "training_overlap_detected": {"const": false},
        "access_log": {"$ref": "common.schema.json#/$defs/artifactReference"},
        "item_level_results": {"$ref": "common.schema.json#/$defs/artifactReference"},
        "reveal_status": {"enum": ["sealed", "dispute_reveal", "program_close_reveal"]}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "harness",
        "hardware_configuration",
        "software_environment",
        "random_seed_commitment",
        "trial_count",
        "raw_logs"
      ],
      "properties": {
        "run_id": {"type": "string", "format": "uri"},
        "harness": {"$ref": "common.schema.json#/$defs/artifactReference"},
        "hardware_configuration": {"$ref": "common.schema.json#/$defs/artifactReference"},
        "software_environment": {"$ref": "common.schema.json#/$defs/artifactReference"},
        "random_seed_commitment": {"$ref": "common.schema.json#/$defs/sha256Digest"},
        "trial_count": {"type": "integer", "minimum": 1},
        "raw_logs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/artifactReference"}
        }
      }
    },
    "metricResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "unit",
        "sample_size",
        "baseline",
        "candidate",
        "absolute_delta",
        "gates"
      ],
      "properties": {
        "metric_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 64},
        "sample_size": {"type": "integer", "minimum": 1},
        "baseline": {"$ref": "common.schema.json#/$defs/decimal"},
        "candidate": {"$ref": "common.schema.json#/$defs/decimal"},
        "absolute_delta": {"$ref": "common.schema.json#/$defs/decimal"},
        "confidence_interval_95": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lower", "upper", "method"],
          "properties": {
            "lower": {"$ref": "common.schema.json#/$defs/decimal"},
            "upper": {"$ref": "common.schema.json#/$defs/decimal"},
            "method": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/gateResult"}
        }
      }
    },
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity", "operator", "threshold", "observed", "passed"],
      "properties": {
        "quantity": {"enum": ["candidate", "absolute_delta", "relative_delta", "baseline"]},
        "operator": {"enum": ["lt", "lte", "gt", "gte", "eq"]},
        "threshold": {"$ref": "common.schema.json#/$defs/decimal"},
        "observed": {"$ref": "common.schema.json#/$defs/decimal"},
        "passed": {"type": "boolean"}
      }
    },
    "safetyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["violation_count", "emergency_stop_count", "passed", "report"],
      "properties": {
        "violation_count": {"type": "integer", "minimum": 0},
        "emergency_stop_count": {"type": "integer", "minimum": 0},
        "passed": {"type": "boolean"},
        "report": {"$ref": "common.schema.json#/$defs/artifactReference"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "passed", "reasons"],
      "properties": {
        "rule": {"enum": ["all_gates", "any_gate", "weighted_score"]},
        "passed": {"type": "boolean"},
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    }
  }
}
