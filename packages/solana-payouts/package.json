{
  "name": "@capy/solana-payouts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "devnet-first native USDC contributor payout rail for Solana",
  "bin": {
    "capy-solana-payouts": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "schema"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@solana-program/compute-budget": "0.18.0",
    "@solana-program/token": "0.16.0",
    "@solana/kit": "8.2.0",
    "canonicalize": "2.1.0",
    "commander": "15.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
