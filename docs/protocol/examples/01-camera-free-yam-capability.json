    "title": "camera-free keyed-peg insertion on an I2RT YAM right arm",
    "summary": "learn contact-robust fixed-geometry insertion from synchronized commands, proprioception, gripper state, safety events, and manual outcomes; cameras, audio, and biometric capture are prohibited.",
    "requester": {
      "actor_id": "urn:capy:actor:requester-lab",
      "role": "capability_requester",
      "key_id": "urn:capy:key:requester-lab-2026-01"
    },
    "embodiment": {
      "manufacturer": "I2RT Robotics",
      "model": "YAM",
      "configuration_id": "yam-right-linear-4310-v1",
      "description_artifacts": [
        {
          "uri": "https://artifacts.example.capy.network/yam/yam-right.urdf",
          "media_type": "application/xml",
          "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111",
          "size_bytes": "48132"
        },
        {
          "uri": "https://artifacts.example.capy.network/yam/yam-right.xml",
          "media_type": "application/xml",
          "digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222",
          "size_bytes": "52709"
        }
      ],
      "controlled_joints": [
        "joint_0",
        "joint_1",
        "joint_2",
        "joint_3",
        "joint_4",
        "joint_5",
        "gripper"
      ],
      "base_frame": "yam_base",
      "tool_frame": "yam_gripper_tip"
    },
    "task": {
      "instruction": "from the declared safe start pose, insert the keyed peg into the surveyed fixed socket, stop on any registered safety event, and record the operator-confirmed outcome before reset.",
      "workspace": {
        "uri": "https://artifacts.example.capy.network/tasks/keyed-peg/workspace-v1.json",
        "media_type": "application/json",
        "digest": "sha256:3333333333333333333333333333333333333333333333333333333333333333",
        "size_bytes": "8441"
      },
      "initial_conditions": [
        "the fixed socket geometry and permitted boundary offsets are identified before motion",
        "the surveyed target pose remains constant for the episode and is not camera-derived",
        "the robot starts inside the safe joint-state envelope with the gripper open"
      ],
      "success_conditions": [
        {
          "channel": "/capy/episode_end",
          "field": "outcome",
          "operator": "eq",
          "value": "success",
          "hold_ms": 0
        }
      ],
      "failure_conditions": [
        "the keyed peg does not reach the registered insertion depth within the task duration",
        "a motor fault, temperature limit, force limit, or manual safety stop is active",
        "the operator or evaluator triggers an emergency stop"
      ],
      "maximum_duration_ms": 12000
    },
    "interfaces": {
